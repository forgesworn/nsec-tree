{
  "name": "nsec-tree",
  "version": "1.5.1",
  "description": "Deterministic Nostr sub-identity derivation from a single master secret",
  "author": "forgesworn",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./mnemonic": {
      "types": "./dist/mnemonic.d.ts",
      "import": "./dist/mnemonic.js"
    },
    "./proof": {
      "types": "./dist/proof.d.ts",
      "import": "./dist/proof.js"
    },
    "./persona": {
      "types": "./dist/persona-barrel.d.ts",
      "import": "./dist/persona-barrel.js"
    },
    "./encoding": {
      "types": "./dist/encoding-barrel.d.ts",
      "import": "./dist/encoding-barrel.js"
    },
    "./event": {
      "types": "./dist/event-barrel.d.ts",
      "import": "./dist/event-barrel.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "PROTOCOL.md",
    "llms.txt",
    "llms-full.txt"
  ],
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:vectors": "vitest run test/vectors.test.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@scure/base": "^2.0.0",
    "@scure/bip32": "^2.0.1",
    "@scure/bip39": "^2.0.1"
  },
  "devDependencies": {
    "nostr-tools": "^2.23.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "keywords": [
    "nostr",
    "nsec",
    "npub",
    "hd-keys",
    "identity",
    "bip32",
    "bip39",
    "derivation",
    "key-derivation",
    "deterministic",
    "secp256k1",
    "schnorr",
    "bech32",
    "mnemonic",
    "privacy",
    "persona",
    "nip-06",
    "nip-19",
    "nip-78",
    "linkage-proof",
    "sub-identity"
  ],
  "homepage": "https://github.com/forgesworn/nsec-tree",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forgesworn/nsec-tree.git"
  },
  "bugs": {
    "url": "https://github.com/forgesworn/nsec-tree/issues"
  },
  "funding": {
    "type": "lightning",
    "url": "lightning:thedonkey@strike.me"
  }
}
